{
  "manifest_version": 3,
  "name": "Video Studio v3 — Theo dõi Facebook",
  "version": "3.0.0",
  "minimum_chrome_version": "120",
  "description": "Thu thập video từ các fanpage đã cấu hình và gửi đến Tool 1 trên máy.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://*.facebook.com/*", "http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://*.facebook.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_popup": "popup.html", "default_title": "Video Studio v3"}
}
